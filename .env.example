# Copy this file to .env.local and fill in your own Supabase project credentials
# to enable shared, cross-visitor community suggestions/upvotes/comments/played
# badges. Get these from your Supabase project's Settings -> API page.
#
# Without these set, the app automatically falls back to storing this data
# per-browser in localStorage — everything still works, it just isn't shared
# across visitors.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Free API key from https://rawg.io/apidocs (sign up, no credit card) that
# powers full-catalog game search (every platform, 1990s consoles through
# today) on the Suggest page. Without it, search falls back to CheapShark's
# Steam-only index, and typing still works manually either way.
VITE_RAWG_API_KEY=

# IGDB search (highest-quality option, tried before RAWG). IGDB auth goes
# through Twitch and needs a short-lived OAuth access token, not a plain
# key — for local dev, generate one yourself:
#   curl -s -X POST "https://id.twitch.tv/oauth2/token" \
#     -d "client_id=YOUR_CLIENT_ID" \
#     -d "client_secret=YOUR_CLIENT_SECRET" \
#     -d "grant_type=client_credentials"
# and paste the resulting access_token below (it expires in ~60 days).
# Never put the client secret itself in this file or in VITE_ vars — see
# the "Search providers" section of README.md for how the deployed site
# gets a fresh token automatically without the secret ever reaching the
# browser.
VITE_IGDB_CLIENT_ID=
VITE_IGDB_ACCESS_TOKEN=
