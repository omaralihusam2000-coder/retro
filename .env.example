# Copy this file to .env.local and fill in your own Supabase project credentials
# to enable shared, cross-visitor community suggestions/upvotes/comments/played
# badges. Get these from your Supabase project's Settings -> API page.
#
# Without these set, the app automatically falls back to storing this data
# per-browser in localStorage — everything still works, it just isn't shared
# across visitors.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
